  <!-- CONTENIDO PRINCIPAL -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full space-y-5">

    <!-- BARRA FLOTANTE DE ACCIONES MASIVAS (APARECE AL SELECCIONAR CASOS) -->
    <div id="bulk-actions-bar" class="hidden bg-slate-900 text-white rounded-2xl p-4 shadow-xl border border-slate-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 sticky top-36 z-30 transition-all">
      <div class="flex items-center space-x-3">
