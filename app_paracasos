      <div class="flex flex-wrap items-center gap-2.5 w-full md:w-auto">
        <!-- Cambiar Estado Masivo -->
        <div class="flex items-center space-x-1.5 bg-slate-800/90 px-3 py-1.5 rounded-xl border border-slate-700">
          <span class="text-xs text-slate-300 font-semibold">Estado:</span>
          <select id="bulk-status-select" class="text-xs font-bold bg-slate-900 border border-slate-700 text-white rounded-lg px-2.5 py-1 focus:outline-none cursor-pointer">
            <option value="Abierto">🟢 Abierto</option>
            <option value="Cerrado">⚪ Cerrado</option>
            <option value="Contabilidad">🟣 Contabilidad</option>
            <option value="Archivado">📦 Archivado</option>
          </select>
          <button onclick="applyBulkStatus()" class="px-3 py-1 bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold rounded-lg transition shadow-xs">
            Aplicar Estado
          </button>
        </div>

        <!-- Reasignar Encargado Masivo -->
        <div class="flex items-center space-x-1.5 bg-slate-800/90 px-3 py-1.5 rounded-xl border border-slate-700">
          <span class="text-xs text-slate-300 font-semibold">Asignar a:</span>
          <select id="bulk-encargado-select" class="text-xs font-bold bg-slate-900 border border-slate-700 text-white rounded-lg px-2.5 py-1 focus:outline-none cursor-pointer">
            <option value="natalia">👤 Natalia Bernal</option>
            <option value="mariana">👤 Mariana Alonso</option>
            <option value="adrian">👤 Adrián Gallo</option>
            <option value="silvia">👤 Silvia Gallo</option>
            <option value="carol">👤 Carol Ostos</option>
            <option value="otros">👤 Otros Colaboradores</option>
          </select>
          <button onclick="applyBulkEncargado()" class="px-3 py-1 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold rounded-lg transition shadow-xs">
