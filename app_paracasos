          <select id="filter-prioridad" onchange="handleFilterChange()" class="text-xs font-semibold bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-slate-700 focus:outline-none focus:border-blue-500 cursor-pointer">
            <option value="todas">Todas las Prioridades</option>
            <option value="ALTA">🚨 Prioridad Alta</option>
            <option value="MEDIA">Prioridad Media</option>
            <option value="BAJA">Prioridad Baja</option>
          </select>

          <select id="filter-orden" onchange="handleFilterChange()" class="text-xs font-semibold bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-slate-700 focus:outline-none focus:border-blue-500 cursor-pointer">
            <option value="correos_desc">Más correos en la cadena</option>
