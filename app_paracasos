      <!-- Barra de Selección Masiva y Conteo -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs text-slate-500 pt-3 mt-3 border-t border-slate-100 gap-2">
        <div class="flex items-center space-x-3">
          <label class="inline-flex items-center space-x-2 cursor-pointer select-none px-2.5 py-1 rounded-lg bg-slate-50 hover:bg-slate-100 border border-slate-200 transition">
            <input type="checkbox" id="master-select-all" onchange="handleSelectAllToggle(this.checked)" class="w-4 h-4 rounded text-blue-600 border-slate-300 focus:ring-blue-500 cursor-pointer">
            <span class="font-bold text-slate-700" id="label-master-select">Seleccionar todos</span>
          </label>
          <span id="results-count-text" class="text-slate-600 font-medium">Mostrando 466 casos</span>
        </div>

        <div class="flex items-center space-x-3">
          <button onclick="toggleExpandAllCases()" id="btn-toggle-all-cases" class="text-blue-600 hover:text-blue-800 font-bold hover:underline transition">
            Desplegar todos los casos
          </button>
          <span class="text-slate-300">|</span>
          <button onclick="resetFilters()" class="text-slate-500 hover:text-slate-800 transition">
            Limpiar filtros
          </button>
        </div>
      </div>
    </div>

    <!-- LISTADO DE CASOS (ENFOQUE PROTAGÓNICO DE GESTIÓN Y CASILLA DE SELECCIÓN) -->
    <div id="cases-container" class="space-y-4">
      <!-- Se genera dinámicamente con JS -->
    </div>

  </main>

  <!-- JAVASCRIPT DE LA APLICACIÓN -->
  <script>
    let db = null;
    let selectedEncargadoId = null; // null = todos
    let searchQuery = '';
    let filterEstado = 'todos';
    let filterPrioridad = 'todas';
    let filterOrden = 'correos_desc';
    let expandedCaseIds = new Set();
    let expandedEmailsCaseIds = new Set();
    let selectedCaseIds = new Set();
    let currentVisibleCaseIds = [];
    let allExpanded = false;
    let isDashboardVisible = true;

    // Almacenamiento local para persistencia de notas, estado y encargado reasignado
    const STORAGE_KEY = 'flujo_agentes_user_edits_v1';
    let userEdits = {};

    function loadUserEdits() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored) userEdits = JSON.parse(stored);
      } catch (e) {
        console.error("No se pudo cargar localStorage:", e);
        userEdits = {};
      }
    }

    function saveUserEdits() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(userEdits));
      } catch (e) {
        console.error("No se pudo guardar en localStorage:", e);
      }
    }

    // Encargados oficiales
    const ENCARGADOS_LIST = [
      { id: 'natalia', name: 'Natalia Bernal', role: 'Legal & Mercantil', email: 'natalia.bernal@grupohispanocolombiano.com', color: '#8b5cf6' },
      { id: 'mariana', name: 'Mariana Alonso', role: 'Operaciones', email: 'mariana.alonso@grupohispanocolombiano.com', color: '#ec4899' },
      { id: 'adrian', name: 'Adrián Gallo', role: 'Dirección & Legal', email: 'adrian.gallo@grupohispanocolombiano.com', color: '#2563eb' },
      { id: 'silvia', name: 'Silvia Gallo', role: 'Finanzas & Contabilidad', email: 'silvia.gallo@grupohispanocolombiano.com', color: '#10b981' },
      { id: 'carol', name: 'Carol Ostos', role: 'Gestión', email: 'carol.ostos@grupohispanocolombiano.com', color: '#f59e0b' },
      { id: 'otros', name: 'Otros Colaboradores', role: 'Soporte y Colaboradores', email: 'colaboradores@grupohispanocolombiano.com', color: '#6366f1' }
    ];

    // Estados validados
    const VALID_STATUSES = ['Abierto', 'Cerrado', 'Contabilidad', 'Archivado'];

    function getNormalizedStatus(caso) {
      const edit = userEdits[caso.id_conversacion];
      if (edit && edit.estado) return edit.estado;
      
      const raw = (caso.estado || 'ABIERTO').trim().toUpperCase();
      if (raw === 'ABIERTO') return 'Abierto';
      if (raw === 'CERRADO') return 'Cerrado';
      if (raw.includes('CONTAB')) return 'Contabilidad';
      if (raw.includes('ARCHIV')) return 'Archivado';
      return 'Abierto';
    }

    function getAssignedEncargadoId(caso) {
      const edit = userEdits[caso.id_conversacion];
      if (edit && edit.encargado_id) return edit.encargado_id;
      return caso.encargado_principal_id || (caso.encargados_ids && caso.encargados_ids[0]) || 'otros';
    }

    function getUserNotes(casoId) {
      const edit = userEdits[casoId];
      return (edit && edit.notas) ? edit.notas : '';
    }

    // Inicializar
    window.addEventListener('DOMContentLoaded', async () => {
      loadUserEdits();

      if (window.__DATABASE__) {
        db = window.__DATABASE__;
      } else {
        try {
          const res = await fetch('data.json');
          db = await res.json();
        } catch (err) {
          console.error("Error al cargar la base de datos:", err);
        }
      }

      if (!db || !db.conversaciones) {
        document.getElementById('cases-container').innerHTML = `
          <div class="p-8 text-center bg-white rounded-2xl border border-red-200 text-red-700 shadow-sm">
            <h3 class="font-bold text-base">No se pudo cargar la base de datos</h3>
            <p class="text-xs mt-1 text-slate-600">Verifica que <code>data.js</code> o <code>data.json</code> estén presentes en la carpeta.</p>
          </div>
        `;
        return;
      }

      updateMetricsDashboard();
      renderEncargadosBar();
      renderCases();
    });

    function toggleDashboard() {
      isDashboardVisible = !isDashboardVisible;
      const panel = document.getElementById('metrics-dashboard-panel');
      const label = document.getElementById('label-toggle-kpis');
      if (isDashboardVisible) {
        panel.classList.remove('hidden');
        label.innerText = 'Ocultar Métricas';
      } else {
        panel.classList.add('hidden');
        label.innerText = 'Mostrar Métricas';
      }
    }

    function updateMetricsDashboard() {
      let countTotal = db.conversaciones.length;
      let countAbiertos = 0;
      let countUrgentes = 0;
      let countContabilidad = 0;
      let countArchivados = 0;
      let openByEncargado = {};

      ENCARGADOS_LIST.forEach(e => openByEncargado[e.id] = 0);

      db.conversaciones.forEach(c => {
        const st = getNormalizedStatus(c);
        const encId = getAssignedEncargadoId(c);

        if (st === 'Abierto') {
          countAbiertos++;
          openByEncargado[encId] = (openByEncargado[encId] || 0) + 1;
          if (c.prioridad === 'ALTA') countUrgentes++;
        } else if (st === 'Contabilidad') {
          countContabilidad++;
        } else if (st === 'Archivado') {
          countArchivados++;
        }
      });

      document.getElementById('kpi-total-casos').innerText = countTotal;
      document.getElementById('kpi-abiertos').innerText = countAbiertos;
      document.getElementById('kpi-urgentes').innerText = countUrgentes;
      document.getElementById('kpi-contabilidad').innerText = countContabilidad;
      document.getElementById('kpi-archivados').innerText = countArchivados;

      // Renderizar barra de distribución de carga de trabajo
      const bar = document.getElementById('kpi-workload-bar');
      const legend = document.getElementById('kpi-workload-legend');
      bar.innerHTML = '';
      legend.innerHTML = '';

      ENCARGADOS_LIST.forEach(e => {
        const count = openByEncargado[e.id] || 0;
        if (count > 0 && countAbiertos > 0) {
          const pct = ((count / countAbiertos) * 100).toFixed(1);
          
          const segment = document.createElement('div');
          segment.style.width = `${pct}%`;
          segment.style.backgroundColor = e.color;
          segment.title = `${e.name}: ${count} casos abiertos (${pct}%)`;
          bar.appendChild(segment);

          const item = document.createElement('span');
          item.className = "flex items-center cursor-pointer hover:text-white transition";
          item.onclick = () => selectEncargado(e.id);
          item.innerHTML = `
            <span class="w-2.5 h-2.5 rounded-full mr-1.5 shrink-0" style="background-color: ${e.color}"></span>
            <strong>${e.name.split(' ')[0]}:</strong> <span class="ml-1">${count} (${pct}%)</span>
          `;
          legend.appendChild(item);
        }
      });
    }

    // Copiar al portapapeles
    function copyText(text, btnId) {
      navigator.clipboard.writeText(text).then(() => {
        const btn = document.getElementById(btnId);
        if (btn) {
          const prev = btn.innerHTML;
          btn.innerHTML = `<span class="text-emerald-600 font-bold">¡Copiado!</span>`;
          setTimeout(() => { btn.innerHTML = prev; }, 1500);
        }
      });
    }

    // Renderizar Barra de Encargados
    function renderEncargadosBar() {
      const bar = document.getElementById('encargados-selector-bar');
      bar.innerHTML = '';

      const counts = { 'todos': db.conversaciones.length };
      db.conversaciones.forEach(c => {
        const encId = getAssignedEncargadoId(c);
        counts[encId] = (counts[encId] || 0) + 1;
      });

      // Botón "Todos"
      const btnTodos = document.createElement('button');
      btnTodos.className = `encargado-pill ${selectedEncargadoId === null ? 'active' : ''} px-3.5 py-2 rounded-xl text-xs font-bold border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 transition flex items-center space-x-2 shrink-0`;
      btnTodos.onclick = () => selectEncargado(null);
      btnTodos.innerHTML = `
        <span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
        <span>Todos los Casos</span>
        <span class="pill-count px-2 py-0.5 rounded-md text-[11px] font-extrabold bg-slate-100 text-slate-700">${counts['todos']}</span>
      `;
      bar.appendChild(btnTodos);

      // Botones para cada encargado
      ENCARGADOS_LIST.forEach(enc => {
        const totalCasos = (counts[enc.id] || 0);
        const isActive = selectedEncargadoId === enc.id;

        const btn = document.createElement('button');
        btn.className = `encargado-pill ${isActive ? 'active' : ''} px-3.5 py-2 rounded-xl text-xs font-bold border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 transition flex items-center space-x-2.5 shrink-0`;
        btn.onclick = () => selectEncargado(enc.id);
        
        btn.innerHTML = `
          <span class="w-3 h-3 rounded-full shrink-0 shadow-2xs" style="background-color: ${enc.color}"></span>
          <span class="font-extrabold">${enc.name}</span>
          <span class="pill-count px-2 py-0.5 rounded-md text-[11px] font-extrabold bg-slate-100 text-slate-700">${totalCasos}</span>
        `;
        bar.appendChild(btn);
      });
    }

    function selectEncargado(encId) {
      selectedEncargadoId = encId;
      
      const label = document.getElementById('active-encargado-label');
      if (encId === null) {
        label.innerText = 'Mostrando: Todos los casos';
      } else {
        const found = ENCARGADOS_LIST.find(e => e.id === encId);
        label.innerText = `Mostrando: Casos asignados a ${found ? found.name : encId}`;
      }

      renderEncargadosBar();
      renderCases();
    }

    // Renderizar Casos con ENFOQUE PROTAGÓNICO Y CASILLA DE SELECCIÓN
    function renderCases() {
      const container = document.getElementById('cases-container');
      container.innerHTML = '';

      let list = db.conversaciones.filter(c => {
        const currentEnc = getAssignedEncargadoId(c);
        const currentStatus = getNormalizedStatus(c);
        const notes = getUserNotes(c.id_conversacion);

        if (selectedEncargadoId !== null) {
          if (currentEnc !== selectedEncargadoId) return false;
        }

        if (filterEstado !== 'todos') {
          if (currentStatus !== filterEstado) return false;
        }

        if (filterPrioridad !== 'todas') {
          if ((c.prioridad || 'MEDIA') !== filterPrioridad) return false;
        }

        if (searchQuery.trim() !== '') {
          const q = searchQuery.toLowerCase().trim();
          const matchCaso = (c.caso || '').toLowerCase().includes(q);
          const matchId = (c.id_conversacion || '').toLowerCase().includes(q);
          const matchCliente = (c.cliente || '').toLowerCase().includes(q);
          const matchLegal = (c.resumen_legal || '').toLowerCase().includes(q);
          const matchNotas = notes.toLowerCase().includes(q);
          
          let matchEmail = false;
          if (c.correos) {
            matchEmail = c.correos.some(m => 
              (m.asunto || '').toLowerCase().includes(q) || 
              (m.informacion_correo || '').toLowerCase().includes(q) ||
              (m.id_correo || '').toLowerCase().includes(q) ||
              (m.remitente || '').toLowerCase().includes(q)
            );
          }

          if (!matchCaso && !matchId && !matchCliente && !matchLegal && !matchNotas && !matchEmail) {
            return false;
          }
        }

        return true;
      });

      if (filterOrden === 'correos_desc') {
        list.sort((a, b) => (b.correos ? b.correos.length : 0) - (a.correos ? a.correos.length : 0));
      } else if (filterOrden === 'prioridad') {
        const pOrder = { 'ALTA': 3, 'MEDIA': 2, 'BAJA': 1 };
        list.sort((a, b) => (pOrder[b.prioridad] || 0) - (pOrder[a.prioridad] || 0));
      } else if (filterOrden === 'nombre_asc') {
        list.sort((a, b) => (a.caso || '').localeCompare(b.caso || ''));
      }

      currentVisibleCaseIds = list.map(c => c.id_conversacion);
      document.getElementById('results-count-text').innerText = `Mostrando ${list.length} casos encontrados`;

      updateBulkActionsUI();

      if (list.length === 0) {
        container.innerHTML = `
          <div class="text-center py-12 bg-white rounded-2xl border border-slate-200 p-6">
            <svg class="w-12 h-12 text-slate-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <h4 class="text-sm font-bold text-slate-800">No se encontraron casos con estos filtros</h4>
            <p class="text-xs text-slate-500 mt-1">Prueba seleccionando otro encargado o restableciendo los filtros de búsqueda.</p>
          </div>
        `;
        return;
      }

      list.forEach(caso => {
        const isExpanded = expandedCaseIds.has(caso.id_conversacion);
        const isEmailsExpanded = expandedEmailsCaseIds.has(caso.id_conversacion);
        const isSelected = selectedCaseIds.has(caso.id_conversacion);
        const numCorreos = caso.correos ? caso.correos.length : 0;
        
        const currentStatus = getNormalizedStatus(caso);
        const currentEncId = getAssignedEncargadoId(caso);
        const currentNotes = getUserNotes(caso.id_conversacion);

        const pBadge = caso.prioridad === 'ALTA' ? 'badge-alta' : (caso.prioridad === 'MEDIA' ? 'badge-media' : 'badge-baja');
        const statusBadgeClass = `status-badge-${currentStatus.toLowerCase()}`;

        const card = document.createElement('div');
        card.className = `case-card ${isExpanded ? 'expanded' : ''} ${isSelected ? 'selected' : ''} bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs`;
        card.id = `case-card-${caso.id_conversacion}`;

        card.innerHTML = `
          <!-- CABECERA PROTAGÓNICA DEL CASO (CENTRO DE GESTIÓN GENERAL) -->
          <div class="p-6 bg-white hover:bg-slate-50/60 transition cursor-pointer select-none" onclick="toggleCase('${caso.id_conversacion}')">
            
            <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4">
              
              <!-- CASILLA DE SELECCIÓN + INFORMACIÓN PRINCIPAL DEL CASO -->
              <div class="flex items-start space-x-3.5 flex-1 min-w-0">
                
                <!-- CASILLA DE SELECCIÓN (CHECKBOX) -->
                <div class="pt-1 shrink-0" onclick="event.stopPropagation()">
                  <input type="checkbox" 
                         id="chk-${caso.id_conversacion}" 
                         ${isSelected ? 'checked' : ''} 
                         onchange="toggleCaseSelection('${caso.id_conversacion}', this.checked)" 
                         class="w-5 h-5 text-blue-600 rounded-md border-slate-300 focus:ring-blue-500 cursor-pointer shadow-2xs transition">
                </div>

                <div class="space-y-2 flex-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="text-xs font-bold px-2.5 py-0.5 rounded-md ${pBadge}">
                      ${caso.prioridad === 'ALTA' ? '🚨 ' : ''}Prioridad ${caso.prioridad || 'MEDIA'}
                    </span>
                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-md bg-slate-100 text-slate-700 border border-slate-200">${caso.categoria || 'General'}</span>
                    <span class="text-[11px] font-mono-code text-slate-500 bg-slate-50 border border-slate-200 px-2 py-0.5 rounded select-all" onclick="event.stopPropagation()">
                      ID: ${caso.id_conversacion}
                    </span>
                  </div>

                  <!-- TÍTULO PROTAGÓNICO DEL CASO -->
                  <h3 class="text-lg sm:text-xl font-black text-slate-900 leading-snug tracking-tight">
                    ${caso.caso || 'Caso sin título'}
                  </h3>

                  <!-- DATOS DEL CLIENTE Y FECHAS -->
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-600 pt-0.5">
                    <span class="flex items-center"><strong class="text-slate-800 mr-1.5">Cliente:</strong> ${caso.cliente || 'No especificado'}</span>
                    ${caso.correo_cliente ? `<span class="text-slate-400">•</span><span class="text-slate-600 truncate max-w-xs">${caso.correo_cliente}</span>` : ''}
                    ${caso.fecha_apertura ? `<span class="text-slate-400">•</span><span><strong>Apertura:</strong> ${caso.fecha_apertura}</span>` : ''}
                    ${caso.fecha_seguimiento ? `<span class="text-slate-400">•</span><span class="text-amber-800 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 font-bold"><strong>Seguimiento:</strong> ${caso.fecha_seguimiento}</span>` : ''}
                  </div>
                </div>

              </div>

              <!-- BARRA DE GESTIÓN DIRECTA: ESTADO + ENCARGADO + CORREOS -->
              <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 shrink-0 pt-2 lg:pt-0" onclick="event.stopPropagation()">
                
                <!-- CASILLA DE ESTADO INTERACTIVA -->
                <div class="space-y-1">
                  <label class="block text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Estado del Caso</label>
                  <select onchange="updateCaseStatus('${caso.id_conversacion}', this.value)" class="text-xs rounded-xl px-3 py-1.5 border shadow-2xs focus:outline-none focus:ring-2 focus:ring-blue-500/20 cursor-pointer font-bold ${statusBadgeClass}">
                    ${VALID_STATUSES.map(st => `
                      <option value="${st}" ${st === currentStatus ? 'selected' : ''}>
                        ${st === 'Abierto' ? '🟢 Abierto' : (st === 'Cerrado' ? '⚪ Cerrado' : (st === 'Contabilidad' ? '🟣 Contabilidad' : '📦 Archivado'))}
                      </option>
                    `).join('')}
                  </select>
                </div>

                <!-- ASIGNACIÓN DEL ENCARGADO INTERACTIVA -->
                <div class="space-y-1">
                  <label class="block text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Encargado Asignado</label>
                  <select onchange="updateCaseEncargado('${caso.id_conversacion}', this.value)" class="text-xs font-bold bg-slate-50 border border-slate-200 text-slate-800 rounded-xl px-3 py-1.5 shadow-2xs focus:outline-none focus:ring-2 focus:ring-blue-500/20 cursor-pointer">
                    ${ENCARGADOS_LIST.map(e => `
                      <option value="${e.id}" ${e.id === currentEncId ? 'selected' : ''}>
                        👤 ${e.name}
                      </option>
                    `).join('')}
                  </select>
                </div>

                <!-- PÍLDORA DE TOTAL DE CORREOS -->
                <div class="space-y-1">
                  <label class="block text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Cadena</label>
                  <div class="inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 shadow-2xs">
                    <svg class="w-3.5 h-3.5 mr-1.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    ${numCorreos} correos
                  </div>
                </div>

                <!-- BOTÓN FLECHA DE DESPLIEGUE -->
                <div class="pt-4 sm:pt-4">
                  <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-blue-100 hover:text-blue-600 transition shadow-2xs">
                    <svg class="w-4 h-4 transform transition-transform ${isExpanded ? 'rotate-180' : ''}" id="arrow-${caso.id_conversacion}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </div>
                </div>

              </div>

            </div>

            <!-- ENLACES DIRECTOS A GOOGLE DOCS Y DRIVE -->
            <div class="flex items-center space-x-3 pt-3 mt-3 border-t border-slate-100 text-xs" onclick="event.stopPropagation()">
              ${caso.doc_maestro ? `
                <a href="${caso.doc_maestro}" target="_blank" class="inline-flex items-center font-bold text-blue-600 hover:text-blue-800 hover:underline">
                  <svg class="w-4 h-4 mr-1.5 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
                  Documento Maestro (Google Docs)
                </a>
              ` : ''}

              ${caso.carpeta_adjuntos ? `
                <a href="${caso.carpeta_adjuntos}" target="_blank" class="inline-flex items-center font-bold text-amber-700 hover:text-amber-900 hover:underline ml-4">
                  <svg class="w-4 h-4 mr-1.5 text-amber-600" fill="currentColor" viewBox="0 0 24 24"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/></svg>
                  Carpeta de Adjuntos (Google Drive)
                </a>
              ` : ''}

              <button onclick="copyText('${caso.id_conversacion}', 'btn-c-id-${caso.id_conversacion}')" id="btn-c-id-${caso.id_conversacion}" class="text-slate-400 hover:text-slate-700 ml-auto font-medium">
                Copiar ID de Conversación
              </button>
            </div>

          </div>

          <!-- CUERPO DESPLEGABLE DEL CASO -->
          <div class="${isExpanded ? 'block' : 'hidden'} border-t border-slate-200 bg-slate-50/60 p-6 space-y-6" id="body-${caso.id_conversacion}">
            
            <!-- SECCIÓN 1: BITÁCORA Y NOTAS DEL ENCARGADO -->
            <div class="bg-white rounded-2xl border border-blue-200 p-5 shadow-xs space-y-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span>
                  <h4 class="text-xs font-black text-slate-900 uppercase tracking-wider">Bitácora y Notas del Encargado</h4>
                </div>
                <span id="save-status-${caso.id_conversacion}" class="text-[11px] text-slate-400 font-medium">Autoguardado en tiempo real</span>
              </div>

              <textarea id="notes-textarea-${caso.id_conversacion}" oninput="handleNotesInput('${caso.id_conversacion}', this.value)" rows="3" placeholder="Escribe aquí los comentarios, acuerdos de llamadas, tareas pendientes o cambios de estrategia de este caso..." class="w-full text-xs text-slate-800 bg-slate-50 focus:bg-white border border-slate-200 focus:border-blue-500 rounded-xl p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition resize-y leading-relaxed">${currentNotes}</textarea>
              
              <div class="flex items-center justify-between text-[11px] text-slate-400 pt-1">
                <span>Esta nota queda asociada permanentemente a este caso.</span>
                <button onclick="saveNotesExplicit('${caso.id_conversacion}')" class="px-3 py-1 bg-slate-900 hover:bg-blue-600 text-white rounded-lg font-bold transition shadow-xs">
                  Guardar Nota
                </button>
              </div>
            </div>

            <!-- SECCIÓN 2: INTELIGENCIA Y RESÚMENES WORKSPACE STUDIO -->
            <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs space-y-4">
              <h4 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center border-b border-slate-100 pb-2">
                <span class="w-2 h-2 rounded-full bg-indigo-600 mr-2"></span>
                Resúmenes Ejecutivos del Caso (Workspace Studio)
              </h4>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                ${caso.resumen_legal ? `
                  <div class="bg-slate-50/90 p-4 rounded-xl border border-slate-200/80">
                    <span class="font-extrabold text-slate-900 flex items-center mb-1.5 text-xs"><span class="mr-1.5">⚖️</span> Resumen Legal:</span>
                    <p class="text-slate-700 leading-relaxed whitespace-pre-line">${caso.resumen_legal}</p>
                  </div>
                ` : ''}

                ${caso.resumen_contable ? `
                  <div class="bg-slate-50/90 p-4 rounded-xl border border-slate-200/80">
                    <span class="font-extrabold text-slate-900 flex items-center mb-1.5 text-xs"><span class="mr-1.5">📊</span> Resumen Contable:</span>
                    <p class="text-slate-700 leading-relaxed whitespace-pre-line">${caso.resumen_contable}</p>
                  </div>
                ` : ''}

                ${caso.riesgos_criticos ? `
                  <div class="bg-rose-50/60 p-4 rounded-xl border border-rose-200/80">
                    <span class="font-extrabold text-rose-900 flex items-center mb-1.5 text-xs"><span class="mr-1.5">⚠️</span> Riesgos y Alertas Críticas:</span>
                    <p class="text-rose-800 leading-relaxed whitespace-pre-line">${caso.riesgos_criticos}</p>
                  </div>
                ` : ''}

                ${caso.tareas ? `
                  <div class="bg-slate-50/90 p-4 rounded-xl border border-slate-200/80">
                    <span class="font-extrabold text-slate-900 flex items-center mb-1.5 text-xs"><span class="mr-1.5">📋</span> Tareas Sugeridas:</span>
                    <p class="text-slate-700 leading-relaxed whitespace-pre-line">${caso.tareas}</p>
                  </div>
                ` : ''}
              </div>

              ${caso.mail_cliente ? `
                <div class="bg-blue-50/40 p-4 rounded-xl border border-blue-200/70 text-xs space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="font-extrabold text-blue-950 flex items-center"><span class="mr-1.5">✉️</span> Borrador Propuesto para el Cliente:</span>
                    <button onclick="copyText(document.getElementById('m-client-${caso.id_conversacion}').innerText, 'btn-cp-mc-${caso.id_conversacion}')" id="btn-cp-mc-${caso.id_conversacion}" class="text-[11px] font-bold text-blue-600 hover:underline">
                      Copiar Borrador
                    </button>
                  </div>
                  <div id="m-client-${caso.id_conversacion}" class="font-mono-code text-slate-700 bg-white p-3.5 rounded-lg border border-slate-200 whitespace-pre-line leading-relaxed select-all">
                    ${caso.mail_cliente}
                  </div>
                </div>
              ` : ''}
            </div>

            <!-- SECCIÓN 3: LA CADENA DE CORREOS -->
            <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs">
              <div class="p-4 bg-slate-50/80 hover:bg-slate-100/80 transition cursor-pointer flex items-center justify-between border-b border-slate-200" onclick="toggleEmailsAccordion('${caso.id_conversacion}')">
                <div class="flex items-center space-x-2">
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <h4 class="text-xs font-extrabold text-slate-800">
                    Historial de la Cadena de Correos (${numCorreos} mensajes enlazados)
                  </h4>
                </div>
                <div class="flex items-center space-x-2">
                  <span class="text-[11px] text-blue-600 font-bold" id="label-emails-${caso.id_conversacion}">
                    ${isEmailsExpanded ? 'Ocultar correos' : 'Desplegar correos'}
                  </span>
                  <svg class="w-4 h-4 text-slate-400 transform transition-transform ${isEmailsExpanded ? 'rotate-180' : ''}" id="arrow-emails-${caso.id_conversacion}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </div>
              </div>

              <div class="${isEmailsExpanded ? 'block' : 'hidden'} p-4 space-y-3 bg-slate-50/30" id="emails-list-${caso.id_conversacion}">
                ${caso.correos.map((correo, index) => `
                  <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-2xs space-y-2">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-2">
                      <div class="flex items-center space-x-2">
                        <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-700 font-extrabold text-[10px] flex items-center justify-center shrink-0">
                          #${index + 1}
                        </span>
                        <h5 class="text-xs font-bold text-slate-900 truncate max-w-md">${correo.asunto || 'Sin asunto'}</h5>
                      </div>

                      <div class="flex items-center space-x-3 text-xs text-slate-500">
                        <span>📅 <strong>Fecha:</strong> ${correo.fecha_correo}</span>
                        ${correo.encargado_nombre ? `<span class="bg-slate-100 px-2 py-0.5 rounded text-[11px] font-bold text-slate-700">Encargado: ${correo.encargado_nombre}</span>` : ''}
                        <span class="font-mono-code text-[10px] text-slate-400 bg-slate-50 px-1 py-0.5 rounded border border-slate-100">ID: ${correo.id_correo}</span>
                      </div>
                    </div>

                    <div class="text-xs text-slate-700 bg-slate-50/70 p-3 rounded-lg border border-slate-100 whitespace-pre-line leading-relaxed font-sans">
                      ${correo.informacion_correo || 'Sin extracto de texto registrado para este correo.'}
                    </div>

                    ${correo.resumen_adjuntos ? `
                      <div class="text-[11px] text-slate-600 bg-amber-50/60 p-2.5 rounded-lg border border-amber-200/60 flex items-start space-x-2">
                        <span class="font-bold text-amber-800 shrink-0">📎 Adjuntos:</span>
                        <span>${correo.resumen_adjuntos}</span>
                      </div>
                    ` : ''}
                  </div>
                `).join('')}
              </div>

            </div>

          </div>
        `;

        container.appendChild(card);
      });
    }

    // ===================================================
    // GESTIÓN DE SELECCIÓN Y ACCIONES MASIVAS
    // ===================================================
    function toggleCaseSelection(casoId, isChecked) {
      if (isChecked) {
        selectedCaseIds.add(casoId);
      } else {
        selectedCaseIds.delete(casoId);
      }

      const card = document.getElementById(`case-card-${casoId}`);
      if (card) {
        if (isChecked) card.classList.add('selected');
        else card.classList.remove('selected');
      }

      updateBulkActionsUI();
    }

    function handleSelectAllToggle(isChecked) {
      if (isChecked) {
        currentVisibleCaseIds.forEach(id => selectedCaseIds.add(id));
      } else {
        currentVisibleCaseIds.forEach(id => selectedCaseIds.delete(id));
      }
      renderCases();
    }

    function clearCaseSelection() {
      selectedCaseIds.clear();
      renderCases();
    }

    function updateBulkActionsUI() {
      const bar = document.getElementById('bulk-actions-bar');
      const countEl = document.getElementById('bulk-selected-count');
      const masterChk = document.getElementById('master-select-all');
      const masterLabel = document.getElementById('label-master-select');

      const count = selectedCaseIds.size;

      if (count > 0) {
        bar.classList.remove('hidden');
        countEl.innerText = `${count} ${count === 1 ? 'caso seleccionado' : 'casos seleccionados'}`;
      } else {
        bar.classList.add('hidden');
      }

      if (currentVisibleCaseIds.length > 0) {
        const allSelected = currentVisibleCaseIds.every(id => selectedCaseIds.has(id));
        const someSelected = currentVisibleCaseIds.some(id => selectedCaseIds.has(id));

        masterChk.checked = allSelected;
        masterChk.indeterminate = !allSelected && someSelected;

        if (allSelected) {
          masterLabel.innerText = `Todos seleccionados (${currentVisibleCaseIds.length})`;
        } else if (someSelected) {
          masterLabel.innerText = `Seleccionados (${count})`;
        } else {
          masterLabel.innerText = 'Seleccionar todos';
        }
      } else {
        masterChk.checked = false;
        masterChk.indeterminate = false;
        masterLabel.innerText = 'Seleccionar todos';
      }
    }

    function applyBulkStatus() {
      if (selectedCaseIds.size === 0) return;
      const newStatus = document.getElementById('bulk-status-select').value;

      selectedCaseIds.forEach(id => {
        if (!userEdits[id]) userEdits[id] = {};
        userEdits[id].estado = newStatus;
      });

      saveUserEdits();
      updateMetricsDashboard();
      
      const prevCount = selectedCaseIds.size;
      clearCaseSelection();
      
      showToastNotification(`Se actualizó el estado a "${newStatus}" en ${prevCount} casos.`);
    }

    function applyBulkEncargado() {
      if (selectedCaseIds.size === 0) return;
      const newEncId = document.getElementById('bulk-encargado-select').value;
      const found = ENCARGADOS_LIST.find(e => e.id === newEncId);
      const encName = found ? found.name : newEncId;

      selectedCaseIds.forEach(id => {
        if (!userEdits[id]) userEdits[id] = {};
        userEdits[id].encargado_id = newEncId;
      });

      saveUserEdits();
      updateMetricsDashboard();
      renderEncargadosBar();
      
      const prevCount = selectedCaseIds.size;
      clearCaseSelection();
      
      showToastNotification(`Se reasignaron ${prevCount} casos a ${encName}.`);
    }

    function showToastNotification(message) {
      const toast = document.createElement('div');
      toast.className = "fixed bottom-5 right-5 z-50 bg-slate-900 text-white text-xs font-bold px-4 py-3 rounded-xl shadow-2xl flex items-center space-x-2 border border-slate-700 animate-bounce";
      toast.innerHTML = `
        <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span>${message}</span>
      `;
      document.body.appendChild(toast);
      setTimeout(() => {
        toast.remove();
      }, 3000);
    }

    function updateCaseStatus(casoId, newStatus) {
      if (!userEdits[casoId]) userEdits[casoId] = {};
      userEdits[casoId].estado = newStatus;
      saveUserEdits();
      updateMetricsDashboard();
      renderCases();
    }

    function updateCaseEncargado(casoId, newEncargadoId) {
      if (!userEdits[casoId]) userEdits[casoId] = {};
      userEdits[casoId].encargado_id = newEncargadoId;
      saveUserEdits();
      updateMetricsDashboard();
      renderEncargadosBar();
      renderCases();
    }

    let notesTimer = null;
    function handleNotesInput(casoId, text) {
      if (!userEdits[casoId]) userEdits[casoId] = {};
      userEdits[casoId].notas = text;
      
      const stEl = document.getElementById(`save-status-${casoId}`);
      if (stEl) stEl.innerHTML = `<span class="text-amber-600">Escribiendo...</span>`;

      clearTimeout(notesTimer);
      notesTimer = setTimeout(() => {
        saveUserEdits();
        if (stEl) stEl.innerHTML = `<span class="text-emerald-600 font-bold">Guardado localmente</span>`;
      }, 500);
    }

    function saveNotesExplicit(casoId) {
      const textarea = document.getElementById(`notes-textarea-${casoId}`);
      if (textarea) {
        if (!userEdits[casoId]) userEdits[casoId] = {};
        userEdits[casoId].notas = textarea.value;
        saveUserEdits();
        const stEl = document.getElementById(`save-status-${casoId}`);
        if (stEl) {
          stEl.innerHTML = `<span class="text-emerald-600 font-bold">¡Guardado con éxito!</span>`;
          setTimeout(() => { stEl.innerText = 'Autoguardado en tiempo real'; }, 2000);
        }
      }
    }

    function toggleCase(convId) {
      const body = document.getElementById(`body-${convId}`);
      const arrow = document.getElementById(`arrow-${convId}`);
      const card = document.getElementById(`case-card-${convId}`);

      if (expandedCaseIds.has(convId)) {
        expandedCaseIds.delete(convId);
        if (body) body.classList.add('hidden');
        if (arrow) arrow.classList.remove('rotate-180');
        if (card) card.classList.remove('expanded');
      } else {
        expandedCaseIds.add(convId);
        if (body) body.classList.remove('hidden');
        if (arrow) arrow.classList.add('rotate-180');
        if (card) card.classList.add('expanded');
      }
    }

    function toggleEmailsAccordion(convId) {
      const list = document.getElementById(`emails-list-${convId}`);
      const arrow = document.getElementById(`arrow-emails-${convId}`);
      const label = document.getElementById(`label-emails-${convId}`);

      if (expandedEmailsCaseIds.has(convId)) {
        expandedEmailsCaseIds.delete(convId);
        if (list) list.classList.add('hidden');
        if (arrow) arrow.classList.remove('rotate-180');
        if (label) label.innerText = 'Desplegar correos';
      } else {
        expandedEmailsCaseIds.add(convId);
        if (list) list.classList.remove('hidden');
        if (arrow) arrow.classList.add('rotate-180');
        if (label) label.innerText = 'Ocultar correos';
      }
    }

    function toggleExpandAllCases() {
      allExpanded = !allExpanded;
      const btn = document.getElementById('btn-toggle-all-cases');

      if (allExpanded) {
        db.conversaciones.forEach(c => expandedCaseIds.add(c.id_conversacion));
        btn.innerText = 'Colapsar todos los casos';
      } else {
        expandedCaseIds.clear();
        btn.innerText = 'Desplegar todos los casos';
      }
      renderCases();
    }

    function handleSearch(val) {
      searchQuery = val;
      renderCases();
    }

    function handleFilterChange() {
      filterEstado = document.getElementById('filter-estado').value;
      filterPrioridad = document.getElementById('filter-prioridad').value;
      filterOrden = document.getElementById('filter-orden').value;
      renderCases();
    }

    function resetFilters() {
      searchQuery = '';
      filterEstado = 'todos';
      filterPrioridad = 'todas';
      filterOrden = 'correos_desc';
      document.getElementById('main-search-input').value = '';
      document.getElementById('filter-estado').value = 'todos';
      document.getElementById('filter-prioridad').value = 'todas';
      document.getElementById('filter-orden').value = 'correos_desc';
      selectEncargado(null);
    }

    function exportEditsBackup() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(userEdits, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `flujo_agentes_cambios_${new Date().toISOString().slice(0,10)}.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    }
  </script>
</body>
</html>
